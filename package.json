{
  "name": "base",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.11.2",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.0.0 <13.0.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "start:local": "nest start --watch --env-file environments/.env.localhost",
    "start:prod": "nest start --watch --env-file environments/.env.production",
    "start:test": "nest start --watch --env-file environments/.env.test",
    "build": "node --max_old_space_size=100000 ./node_modules/@nestjs/cli/bin/nest.js build",
    "dist:test": "node --env-file=./environments/.env.test dist/src/config/bootstrap/main",
    "dist:prod": "node --env-file=./environments/.env.production dist/src/config/bootstrap/main",
    "debug:local": "nest start --debug 9000 --watch --env-file environments/.env.localhost",
    "debug:prod": "nest start --debug 9000 --watch --env-file environments/.env.production",
    "debug:test": "nest start --debug 9000 --watch --env-file environments/.env.test",
    "format": "prettier --write \"{src,environments}/**/*.ts\"",
    "lint": "eslint \"{src,environments,apps,libs}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "@types/luxon": "^3.7.6",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "crypto-js": "^4.2.0",
    "express": "^5.3.0",
    "fs-extra": "^11.4.1",
    "luxon": "^3.7.2",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "rotating-file-stream": "^3.2.10",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
