{
  "compilerOptions": {
    /* ------------- strict type checking ------------- */

    "strict": true,

    /* ------------- modulos y compilacion ------------- */

    "module": "commonjs",
    "target": "ES2021",
    "types": ["node", "jest"],
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "environments/*": ["./environments/*"]
    }
  }
}
